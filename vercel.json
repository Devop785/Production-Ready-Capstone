{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run setup:turso",
  "outputDirectory": "public",
  "functions": {"api/index.js": {"includeFiles": "public/**", "maxDuration": 30}},
  "rewrites": [
    {"source": "/api/:path*", "destination": "/api/index"},
    {"source": "/health/:path*", "destination": "/api/index"},
    {"source": "/health", "destination": "/api/index"}
  ],
  "headers": [{"source": "/(.*)", "headers": [
    {"key": "X-Content-Type-Options", "value": "nosniff"},
    {"key": "Referrer-Policy", "value": "no-referrer"},
    {"key": "X-Frame-Options", "value": "DENY"},
    {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"}
  ]}]
}
